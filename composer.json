{
    "name": "rkr/ai-watermark-removal-tools",
    "description": "Clean invisible Unicode marks in text and remove embedded C2PA provenance metadata from images without re-encoding pixels.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "unicode",
        "watermark",
        "text",
        "c2pa",
        "image-metadata"
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pcre": "*",
        "lib-pcre": ">=10.40"
    },
    "autoload": {
        "psr-4": {
            "Rkr\\WatermarkRemoval\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/text.php",
            "@php tests/images.php"
        ]
    }
}
